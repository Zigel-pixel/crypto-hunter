BOT_TOKEN=your_bot_token_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ALERT_CHECK_INTERVAL_SECONDS=60
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
OPTIMISM_RPC_URL=
AVALANCHE_RPC_URL=
TRON_API_KEY=
WALLET_SCAN_TIMEOUT_SECONDS=15
WALLET_MAX_CONCURRENT_SCANS=3
LIVE_CHART_REFRESH_SECONDS=45

# Optional administrator-only internal QA bot (separate Telegram bot token)
QA_BOT_TOKEN=
QA_ADMIN_TELEGRAM_ID=
QA_REPORTS_DIR=qa/reports
QA_SCENARIO_TIMEOUT_SECONDS=60
QA_MAX_PARALLEL_SCENARIOS=3
QA_REAL_PROVIDER_CHECKS=false
QA_GITHUB_ISSUES_ENABLED=false
QA_GITHUB_REPOSITORY=Zigel-pixel/crypto-hunter
QA_GITHUB_TOKEN=

# Optional real Telegram E2E through a dedicated Telethon user account
E2E_ENABLED=false
E2E_TELEGRAM_API_ID=
E2E_TELEGRAM_API_HASH=
E2E_TELEGRAM_PHONE=
E2E_TARGET_BOT_USERNAME=
E2E_SESSION_PATH=qa/e2e_sessions/crypto-hunter-e2e
E2E_DEFAULT_TIMEOUT_SECONDS=20
E2E_LONG_TIMEOUT_SECONDS=90
E2E_MESSAGE_SETTLE_SECONDS=2
E2E_REPORTS_DIR=qa/e2e_reports
E2E_ARTIFACTS_DIR=qa/e2e_artifacts
E2E_MAX_SCENARIO_SECONDS=180
E2E_ALLOW_DESTRUCTIVE_SCENARIOS=false
E2E_TEST_LANGUAGE=uk
E2E_LIVE_WAIT_SECONDS=50

# Optional unattended deployment reporting/notification policy
DEPLOYMENT_NOTIFICATIONS_ENABLED=true
DEPLOYMENT_REPORTS_DIR=.deployment/reports
DEPLOYMENT_STATE_PATH=.deployment/state.json
DEPLOYMENT_ROLLBACK_ON_SMOKE_E2E_FAILURE=true
DEPLOYMENT_ROLLBACK_ON_FULL_E2E_FAILURE=false
DEPLOYMENT_BOT_WARMUP_SECONDS=15
DEPLOYMENT_PROCESS_HEALTH_SECONDS=15
DEPLOYMENT_MAX_SECONDS=900
DEPLOYMENT_BRANCH=feat/market-core
